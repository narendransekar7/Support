{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Ocelot": "Warning",
      "MassTransit": "Information"
    },
    "Console": {
      // "simple" = readable single lines (local dev); docker-compose/k8s override to "json"
      // via Logging__Console__FormatterName so log collectors get structured entries.
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  // HS256 key for the Support System's tokens - both sign-in options (minted by SS.Auth.Server.API, validated by SS.Gateway.API
  // and SS.User.API) - must be identical in all three. This is a development default: override it per environment
  // with Jwt__SigningKey (k8s/Helm: JWT_SIGNING_KEY in the supportsystem-secrets Secret) and rotate it.
  "Jwt": {
    "SigningKey": "hldiSW6BAHCCzY9Yy1zQLiN+MHYJ0Fm5InfQlPANUyM="
  },
  // StackExchange.Redis connection string for the rate limiter's counters; docker-compose/k8s override it with
  // Redis__ConnectionString (e.g. Azure Cache for Redis: "<name>.redis.cache.windows.net:6380,password=...,ssl=True").
  // Empty = rate limiting off. Short timeouts: a slow Redis must not slow every request down (the limiter fails open).
  "Redis": {
    "ConnectionString": "localhost:6379,connectTimeout=2000,syncTimeout=500,asyncTimeout=500"
  },
  // Sliding-window limits per client, shared by all gateway replicas through Redis (see RateLimiting/).
  //   Auth: /api/auth/* per client IP.   Api: every other /api/* route per signed-in user (per IP if anonymous).
  // Over the limit -> 429 Too Many Requests + Retry-After. Override with RateLimiting__Api__PermitLimit etc.
  "RateLimiting": {
    "Enabled": true,
    "KeyPrefix": "ss:ratelimit",
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Api": { "PermitLimit": 300, "WindowSeconds": 60 }
  },
  // Application Insights connection string - leave empty to disable OpenTelemetry export (logs still go to stdout).
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
