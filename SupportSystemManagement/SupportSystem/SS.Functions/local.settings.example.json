{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "SlaBreachCheckerSchedule": "0 */5 * * * *",
    "SlaBreachChecker__BatchSize": "100",

    "ConnectionStrings__DefaultConnection": "<same SupportSystem database as the APIs>",

    "Messaging__Provider": "Kafka",
    "Messaging__Kafka__BootstrapServers": "localhost:9092",
    "Messaging__AzureServiceBus__ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
    "Messaging__AzureServiceBus__AutoCreateEntities": "false",
    "RabbitMq__Host": "localhost",
    "RabbitMq__VirtualHost": "/",
    "RabbitMq__Username": "guest",
    "RabbitMq__Password": "guest",

    "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
  }
}
