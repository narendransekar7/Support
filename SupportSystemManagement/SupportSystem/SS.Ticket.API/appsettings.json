{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Ocelot": "Warning",
      "MassTransit": "Information"
    },
    "Console": {
      // "simple" = readable single lines (local dev); docker-compose/k8s override to "json"
      // via Logging__Console__FormatterName so log collectors get structured entries.
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"DefaultConnection": "Server=learningdatanaren.database.windows.net;Database=SupportSystem;User Id=narendran;Password=Admin@123;TrustServerCertificate=True;"
    "DefaultConnection": "Server=DESKTOP-UNRL1OC\\SQLEXPRESS;Database=SupportSystem;User Id=testnaren;Password=Naren@123;TrustServerCertificate=True;"
  },
  // Which broker carries messages - Kafka | RabbitMq | AzureServiceBus (not implemented yet).
  // Override per environment with Messaging__Provider; see SS.Base.Messaging and docs/messaging/KAFKA.md.
  "Messaging": {
    "Provider": "Kafka",
    "Kafka": {
      // docker-compose.kafka.yml exposes the broker here; inside docker-compose it's kafka:9092.
      "BootstrapServers": "localhost:9092"
    }
  },
  // Used when Messaging:Provider is RabbitMq.
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  // Application Insights connection string - leave empty to disable OpenTelemetry export (logs still go to stdout).
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
